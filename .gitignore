/xdev
/xdev.exe

# release artifacts (the release workflow and any local packaging write these).
# Anchored: an unanchored `dist/` also swallows the source package
# internal/dist/, which makes `git add` silently drop new files there.
/dist/

# local tool scratch: the edit/write/bash self-tests run in here
.selftest/

# git worktrees for feature branches (the repo's own convention: every
# change happens in .worktrees/<slug>, never in the shared checkout)
.worktrees/

# go test + coverage output
*.test
coverage.out
