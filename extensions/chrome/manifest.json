{
  "manifest_version": 3,
  "name": "xdev Browser",
  "version": "0.1.0",
  "description": "Lets the xdev coding agent drive tabs in this Chrome profile over a local native-messaging bridge (CDP-compatible).",
  "key": "",
  "icons": {
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "xdev Browser",
    "default_icon": {
      "128": "icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
